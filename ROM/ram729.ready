// ─── READY‑MODULE · ROM3 ─────────────────────────────────────────────
// Voll JS‑fähig, Imperium‑kompatibel, Etage 3 (UR)

export const READY = {

    // Name des Moduls (automatisch aus Dateiname ableitbar)
    name: import.meta.url.split('/').pop(),

    // Basis‑Input
    input: {
        x: 0,
        y: 0,
        z: 0,
        mass: 1,
        time: 1,
        axiom: "e",
        axis: "e",
        etage: 3   // ← UR
    },

    // Setzen von Input
    set(input = {}) {
        Object.assign(this.input, input);
        return this;
    },

    // Haupt‑Algorithmus (hier kommt deine Logik rein)
    compute() {
        const { x, y, z, mass, time, axiom, axis, etage } = this.input;

        const sum = x + y + z;
        const torque = sum * mass * time;

        const result = {
            module: this.name,
            etage,
            axis,
            sum,
            torque,
            axiomVector: this.axiomVector(axiom),
            dqf: this.dqf(etage),
            timestamp: new Date().toISOString()
        };

        return result;
    },

    // Axiom‑Vektoren (d/e/i/n/o/r/s/w/u)
    axiomVector(key) {
        const AX = {
            d: 1.11,
            e: 1.33,
            i: 0.77,
            n: 0.92,
            o: 1.44,
            r: 1.66,
            s: 1.21,
            w: 1.55,
            u: 2.00
        };
        return AX[key] ?? 1;
    },

    // DQF‑Routing (Etagen)
    dqf(etage) {
        const DQF = {
            3: "UR",
            9: "KERN",
            27: "ORBIT",
            81: "RAUM",
            729: "LEBEN"
        };
        return DQF[etage] ?? "UNKNOWN";
    }
};
