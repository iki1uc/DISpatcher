// ─── RUN‑3 · pipelineblitz ─────────────────────────────────────────────
// Führt jedes READY‑MODULE aus (PQ, RAM, ROM) – besonders ram9.ready (KERN)

export const RUN3 = {

    // Pipeline‑Name
    name: "RUN‑3 · pipelineblitz",

    // Lädt ein READY‑Modul dynamisch
    async loadReady(path) {
        const mod = await import(path);
        return mod.READY ?? mod.default;
    },

    // Führt ein READY‑Modul aus
    async execute(path, input = {}) {
        const READY = await this.loadReady(path);

        // Input setzen (Ur‑Form bleibt unverändert)
        READY.set(input);

        // Compute ausführen
        const result = READY.compute();

        // Pipeline‑Blitz‑Output
        return {
            pipeline: this.name,
            module: READY.name,
            input: READY.input,
            output: result,
            timestamp: new Date().toISOString()
        };
    }
};
