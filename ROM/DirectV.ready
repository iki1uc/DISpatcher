// ─── READY-MODULE · DISpatcher-Imperium ─────────────────────────────
// Jede .ready Datei nutzt dieses Grundmuster
// Voll JS-fähig, Achsen-fähig, Axiom-fähig, RUN-fähig

export const READY = {

    // Name des Moduls (automatisch aus Dateiname)
    name: import.meta.url.split('/').pop(),

    // Basis-Input
    input: {
        x: 0,
        y: 0,
        z: 0,
        mass: 1,
        time: 1,
        axiom: "e",
        axis: "e",
        etage: 9
    },

    // Input setzen
    set(input = {}) {
        Object.assign(this.input, input);
        return this;
    },

    // Haupt-Compute (RAM/ROM-kompatibel)
    compute() {
        const { x, y, z, mass, time, axiom, axis, etage } = this.input;

        const sum = x + y + z;
        const torque = sum * mass * time;

        return {
            module: this.name,
            axis,
            etage,
            sum,
            torque,
            axiomVector: this.axiomVector(axiom),
            axisVector: this.axisVector(axis),
            dqf: this.dqf(etage),
            timestamp: new Date().toISOString()
        };
    },

    // Axiom-Vektoren (d/e/i/n/o/r/s/w/u)
    axiomVector(key) {
        const AX = {
            d: 1.11,
            e: 1.33,
            i: 0.77,
            n: 0.92,
            o: 1.44,
            r: 1.66,
            s: 1.21,
            w: 1.55,
            u: 2.00
        };
        return AX[key] ?? 1;
    },

    // Achsen-Vektoren (für PQ/RAM/ROM)
    axisVector(key) {
        const VEC = {
            d: [1,0,0],
            e: [0,1,0],
            i: [0,0,1],
            n: [1,1,0],
            o: [1,0,1],
            r: [0,1,1],
            s: [1,1,1],
            w: [2,1,0],
            u: [0,2,1]
        };
        return VEC[key] ?? [0,0,0];
    },

    // DQF (Etagen-basiert)
    dqf(etage) {
        const DQF = {
            3:  "UR",
            9:  "KERN",
            27: "ORBIT",
            81: "RAUM",
            729:"LEBEN"
        };
        return DQF[etage] ?? "UNKNOWN";
    }
};
