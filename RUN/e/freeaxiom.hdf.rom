// ─── Achse-e-Koppler für freeaxiom ─────────────────────────────

import freeAxiom from "./freeaxiom.hdf.rom";

export function koppelnE(achse) {

    const AXIOM_E = 1.33; // Achse e Standardwert

    // Wenn Achse e aktiv ist → Achsenwert zurückgeben
    if (achse === "e") {
        return {
            typ: "achse",
            achse: "e",
            wert: AXIOM_E,
            quelle: "axis-core"
        };
    }

    // Wenn Achse NICHT e ist → freeaxiom aktivieren
    return {
        typ: "freeaxiom",
        achse: "free",
        wert: freeAxiom.vector,
        beschreibung: freeAxiom.beschreibung,
        antwort: freeAxiom.antwort,
        zone: freeAxiom.zone,
        meta: freeAxiom.meta,
        quelle: "free-zone"
    };
}
