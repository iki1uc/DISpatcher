import freeAxiom from "./freeaxiom.hdf.rom";

export function koppelnN(achse) {

    const AXIOM_N = 0.92; // Achse n Standardwert

    if (achse === "n") {
        return {
            typ: "achse",
            achse: "n",
            wert: AXIOM_N,
            quelle: "axis-core"
        };
    }

    return {
        typ: "freeaxiom",
        achse: "free",
        wert: freeAxiom.vector,
        beschreibung: freeAxiom.beschreibung,
        antwort: freeAxiom.antwort,
        zone: freeAxiom.zone,
        meta: freeAxiom.meta,
        quelle: "free-zone"
    };
}
