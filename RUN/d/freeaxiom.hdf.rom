// ─── Achsen-Koppler für freeaxiom ─────────────────────────────

import freeAxiom from "./freeaxiom.hdf.rom";

export function koppeln(achse) {

    const AXIOME = {
        d: 1.11,
        e: 1.33,
        i: 0.77,
        n: 0.92,
        o: 1.44,
        r: 1.66,
        s: 1.21,
        w: 1.55,
        u: 2.00
    };

    // Wenn Achse existiert → Achsenwert zurückgeben
    if (AXIOME[achse]) {
        return {
            typ: "achse",
            achse,
            wert: AXIOME[achse],
            quelle: "axis-core"
        };
    }

    // Wenn Achse fehlt → freeaxiom aktivieren
    return {
        typ: "freeaxiom",
        achse: "free",
        wert: freeAxiom.vector,
        beschreibung: freeAxiom.beschreibung,
        antwort: freeAxiom.antwort,
        quelle: "free-zone"
    };
}
