// ─── RIR.Core ──────────────────────────────────────────────
// Reinheitsinstanz · Existenz · Struktur · Reinheit

export const RIR = {

    exist(input) {
        return input !== undefined && input !== null;
    },

    structure(input) {
        if (typeof input !== "object") return false;
        return ["x", "y", "z"].every(key => key in input);
    },

    purity(input) {
        const { x, y, z } = input;
        return Number.isFinite(x) && Number.isFinite(y) && Number.isFinite(z);
    },

    filter(input) {
        if (!this.exist(input)) return null;
        if (!this.structure(input)) return null;
        if (!this.purity(input)) return null;
        return input;
    },

    return(input) {
        const packet = this.filter(input);
        if (!packet) return { RIR: "reject" };
        return { RIR: "accept", packet };
    }
};
